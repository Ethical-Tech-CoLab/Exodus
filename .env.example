# Exodus — environment variables
# Copy to .env and fill in the keys you have. Everything works without keys
# (with fallback / static data), but AI + live feeds require these.

# ACAPS API key — register free at https://api.acaps.org/register/
ACAPS_API_KEY=

# Anthropic (Claude) — powers AI country context in the Crisis Map drawer
# https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Tavily — real-time news per crisis (Crisis Map drawer)
# https://tavily.com/
TAVILY_API_KEY=

# ACLED — structured conflict timeline (Crisis Map drawer)
# OAuth2 login (the legacy key+email API is deprecated)
# Register at https://developer.acleddata.com/
ACLED_EMAIL=
ACLED_PASSWORD=

# NASA — Earth Imagery snapshot in the Crisis Map Live tab (optional)
# https://api.nasa.gov/
NASA_API_KEY=

# Optional: server port (defaults to 8000)
# PORT=8000
